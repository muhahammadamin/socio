{
  "name": "socio",
  "version": "1.0.0",
  "private": true,
  "description": "Socio — платформа взаимопомощи: Vue 3 + Express + SQLite",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "nodemon --quiet --watch server --watch shared --ext js --exec \"node --env-file-if-exists=.env server/index.js --dev\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed-cli.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "nodemon": "^3.1.14",
    "vite": "^8.3.8",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  }
}
