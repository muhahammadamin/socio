# Все переменные необязательны — без них всё работает в демо-режиме.
PORT=3000
# Облачная база Turso (turso.tech). Без этих двух строк база — локальный файл в DATA_DIR.
# TURSO_DATABASE_URL=libsql://socio-имя.turso.io
# TURSO_AUTH_TOKEN=
# Папка для локальной базы SQLite и ключа подписи (в Docker — /data)
DATA_DIR=./data
# true — заполнить пустую базу демо-данными и показать вход в один клик; false — чистая база
DEMO=true
# Первый администратор (создаётся, если админов ещё нет)
ADMIN_PHONE=+998 90 000-00-00
ADMIN_PASSWORD=admin123
# Ключ подписи токенов. Если не задан — генерируется и хранится в DATA_DIR/secret.key
# SECRET=
# Вход и регистрация через Google: OAuth Client ID (тип «Web application») из Google Cloud Console.
# В «Authorized JavaScript origins» добавьте адрес сайта, например http://localhost:3000
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
